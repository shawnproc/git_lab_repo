# Copy to .env (git-ignored) and adjust. Never commit real values.

# Where the SQLite DB and the one-time setup token live.
# Default: %LOCALAPPDATA%\KeystoneLedger on Windows, ./var (mode 0700) elsewhere.
# KL_DATA_DIR=

# Bind address. Loopback only; the app refuses anything else unless KL_ALLOW_NON_LOOPBACK=true.
# KL_HOST=127.0.0.1
# KL_PORT=8787

# Set true only when served over HTTPS (e.g. `tailscale serve`, Phase 4). Enables Secure cookie + HSTS.
# KL_HTTPS=false
# KL_EXTRA_ALLOWED_HOSTS=["your-machine.tailnet-name.ts.net"]

# Session / login policy
# KL_SESSION_IDLE_HOURS=12
# KL_LOGIN_MAX_FAILURES=5
# KL_LOGIN_LOCKOUT_MINUTES=15

# Required for fundamentals: SEC EDGAR wants a User-Agent naming you plus a contact email.
KL_SEC_USER_AGENT="Your Name you@example.com"
